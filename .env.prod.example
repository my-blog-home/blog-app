# 배포 환경변수 예시. 실제 값은 서버에만 두고 Git에 올리지 않는다
SPRING_PROFILES_ACTIVE=prod
PORT=8080
DB_URL=jdbc:postgresql://DB주소:5432/myblog
DB_USERNAME=myblog
DB_PASSWORD=
REDIS_HOST=Redis주소
REDIS_PORT=6379
REDIS_PASSWORD=
MAIL_MODE=smtp
# 메일 없이 시험할 때만 true (인증번호를 화면에 보여 줌). 운영에서는 false
SHOW_CODE_ON_SCREEN=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Gmail 주소와 앱 비밀번호(구글 계정 비밀번호가 아님)
SMTP_USERNAME=
SMTP_PASSWORD=
# 비우면 "Ylog <SMTP_USERNAME>"
SMTP_FROM=
IMAGE_DIR=/var/lib/ylog/images
COOKIE_SECURE=true
# 관리자 계정 (선택). 둘 다 값이 있으면 처음 켤 때 그 이메일로 관리자를 만든다
ADMIN_EMAIL=
ADMIN_PASSWORD=
