# 배포 환경변수 예시. 실제 값은 서버에만 두고 Git에 올리지 않는다
SPRING_PROFILES_ACTIVE=prod
PORT=8080
DB_URL=jdbc:postgresql://DB주소:5432/myblog
DB_USERNAME=myblog
DB_PASSWORD=
REDIS_HOST=Redis주소
REDIS_PORT=6379
REDIS_PASSWORD=
MAIL_MODE=smtp
# 시험 운영 때만 true (인증번호를 화면에 보여 줌)
SHOW_CODE_ON_SCREEN=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
IMAGE_DIR=/var/lib/ylog/images
COOKIE_SECURE=true
